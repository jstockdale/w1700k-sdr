#!/usr/bin/env python3
# SPDX-License-Identifier: MIT
"""Build a unit's own root filesystem: the built root plus its login key.

init/install and init/flash do this themselves. Run it directly to set up a
unit directory for a unit installed elsewhere. Its ssh host key is the unit's
own and stays on it; this host needs the public half, to know the unit by:

    init/provision --unit SERIAL --host-key FILE

FILE holds the key as the unit's installer printed it, a known_hosts line or a
.pub file.
"""
import argparse
from pathlib import Path
import sys

sys.path.insert(0, str(Path(__file__).resolve().parent))
from initkit import backup, config, provision         # noqa: E402


def main():
    settings = config.load()
    parser = argparse.ArgumentParser(description=__doc__,
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument('--unit', metavar='SERIAL', required=True)
    parser.add_argument('--data-dir', type=Path, default=Path(settings['data_dir']))
    parser.add_argument('--authorized-key', metavar='FILE',
                        default=settings['authorized_key'])
    parser.add_argument('--no-login-key', action='store_true',
                        help='build no login key into the root: the unit takes its key from its '
                             'reset button alone (init/key)')
    parser.add_argument('--host-key', metavar='FILE', type=Path,
                        help="the unit's ssh host key, public half: recorded as the key this host "
                             'knows the unit by')
    args = parser.parse_args()
    if not backup.SERIAL_FORM.match(args.unit):
        parser.error('--unit must be the unit serial')
    directory = config.unit_dir(args.data_dir, args.unit)
    try:
        if args.host_key:
            for entry in provision.known_host(directory, settings['device_ip'],
                                              provision.public_lines(args.host_key.read_text())):
                print(f'provision: host key {provision.fingerprint(entry.split(None, 1)[1])}')
        image = provision.provision(directory, args.authorized_key, address=settings['device_ip'],
                                    no_login_key=args.no_login_key)
    except (provision.ProvisionError, OSError) as error:
        sys.exit(f'provision: {error}')
    print(f'provision: {image}')
    return 0


if __name__ == '__main__':
    sys.exit(main())
