#!/usr/bin/env python3
# SPDX-License-Identifier: MIT
"""Set up this host's directory for a unit.

init/install and init/flash do this themselves. Run it directly for a unit
installed elsewhere. Every unit's root is the built one; what is a unit's own
is on the unit: its login keys (`w1700k-login` there), its network settings
(`w1700k-network`; a network.conf in its directory here is sent by the tools)
and its ssh host key, which stays on it. This host needs that key's public
half, to know the unit by:

    init/provision --unit SERIAL --host-key FILE

FILE holds the key as the unit's installer printed it, a known_hosts line or a
.pub file.
"""
import argparse
from pathlib import Path
import sys

sys.path.insert(0, str(Path(__file__).resolve().parent))
from initkit import backup, config, provision         # noqa: E402


def main():
    settings = config.load()
    parser = argparse.ArgumentParser(description=__doc__,
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument('--unit', metavar='SERIAL', required=True)
    parser.add_argument('--data-dir', type=Path, default=Path(settings['data_dir']))
    parser.add_argument('--host-key', metavar='FILE', type=Path,
                        help="the unit's ssh host key, public half: recorded as the key this host "
                             'knows the unit by')
    args = parser.parse_args()
    if not backup.SERIAL_FORM.match(args.unit):
        parser.error('--unit must be the unit serial')
    directory = config.unit_dir(args.data_dir, args.unit)
    try:
        if args.host_key:
            for entry in provision.known_host(directory, settings['device_ip'],
                                              provision.public_lines(args.host_key.read_text())):
                print(f'provision: host key {provision.fingerprint(entry.split(None, 1)[1])}')
        image = provision.provision(directory, address=settings['device_ip'])
    except (provision.ProvisionError, OSError) as error:
        sys.exit(f'provision: {error}')
    print(f'provision: {image}')
    return 0


if __name__ == '__main__':
    sys.exit(main())
