#!/usr/bin/env python3
# SPDX-License-Identifier: MIT
"""Make an update archive a release: seal its manifest with a release key.

    init/sign keygen KEYFILE                      # a new signing key, and its line for a unit
    init/sign public KEYFILE                      # that line again
    init/sign archive --key KEYFILE --release N [ARCHIVE] [-o OUT]
    init/sign check --keys FILE ARCHIVE           # is it a release, and which of these keys' is it

    init/sign request --release N [ARCHIVE] [-o REQUEST]       # for a key that signs elsewhere:
    init/sign attach --request REQUEST --signature SIG --keys FILE [ARCHIVE] [-o OUT]

A unit built with release keys in it (`W1700K_RELEASE_KEYS=FILE make`, see platform/README.md)
takes over ssh only what one of them sealed, and nothing older than the release it has settled
on. `keygen` writes the private half of a key to KEYFILE, readable by you alone, and prints the
public half as one line of such a file. Keep two: one to sign with, one that stays offline until
the first is lost.

`archive` writes ARCHIVE (default: this build's w1700k-update.tar) again as release N, with the
number in its manifest and the manifest sealed, to OUT (default: w1700k-release-N.tar beside
it). The manifest lists the SHA-256 of every image in the archive, so the one signature covers
them all. N only ever goes up: a unit that has settled on release 7 refuses release 6.

A key that never leaves its keeper signs in two steps. `request` writes what there is to sign
for release N: a small JSON file with the release number, the exact bytes (`sign`, in hex: the
topic, the envelope's header and the manifest, which is readable in them from `manifest_at`)
and their SHA-256. The keeper signs those bytes (Ed25519, RFC 8032) and returns 64 bytes.
`attach` takes them as 128 hex digits or a file of them, checks them against FILE's public
keys, and writes the release; a signature that is not over this request, by one of those keys,
writes nothing. The archive has to be the one the request was made of.

The envelope is Whitehat Hardware's WMS2 (`seal/`, init/initkit/seal.py). Signing takes the
Python package `cryptography` or PyNaCl; checking takes neither.
"""
import argparse
import hashlib
import json
import os
from pathlib import Path
import sys
import time

sys.path.insert(0, str(Path(__file__).resolve().parent))
from initkit import bundle, config, seal                # noqa: E402
from initkit.console import StepFailed                  # noqa: E402


def read_seed(path):
    try:
        text = Path(path).read_text().strip()
        seed = bytes.fromhex(text)
    except (OSError, ValueError) as error:
        raise StepFailed(f'{path} is not a signing key: {error}') from None
    if len(seed) != 32:
        raise StepFailed(f'{path} is not a signing key: it holds {len(seed)} bytes, not 32')
    return seed


def read_request(path):
    """(release number, time, the bytes to sign) of a signing request."""
    try:
        request = json.loads(Path(path).read_text())
        release, when, message = request['release'], request['time_ms'], bytes.fromhex(request['sign'])
        if type(release) is not int or type(when) is not int:
            raise ValueError('its release and time are not numbers')
        if hashlib.sha256(message).hexdigest() != request['sign_sha256']:
            raise ValueError('its bytes are not the ones its SHA-256 names')
    except (OSError, KeyError, TypeError, ValueError) as error:
        raise StepFailed(f'{path} is not a signing request: {error}') from None
    return release, when, message


def read_signature(given):
    """A signature given as 128 hex digits, or as a file of them."""
    try:
        text = Path(given).read_text() if Path(given).is_file() else given
        signature = bytes.fromhex(''.join(text.split()))
    except (OSError, ValueError) as error:
        raise StepFailed(f'not a signature (128 hex digits, or a file of them): {error}') from None
    if len(signature) != seal.SIGNATURE:
        raise StepFailed(f'a signature is {seal.SIGNATURE} bytes; this is {len(signature)}')
    return signature


def unwritten(path, what):
    if path.exists():
        raise StepFailed(f'{path} exists; {what} is never overwritten')
    return path


def key_line(public, note):
    return f'{public.hex()}  {note} ({seal.fingerprint(public)})'


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    verbs = parser.add_subparsers(dest='verb', required=True)
    for name in ('keygen', 'public'):
        verb = verbs.add_parser(name)
        verb.add_argument('keyfile', type=Path, metavar='KEYFILE')
    archive = verbs.add_parser('archive')
    archive.add_argument('--key', type=Path, required=True, metavar='KEYFILE')
    archive.add_argument('--release', type=int, required=True, metavar='N')
    archive.add_argument('archive', type=Path, nargs='?', default=config.UPDATE, metavar='ARCHIVE')
    archive.add_argument('-o', '--output', type=Path, metavar='OUT')
    check = verbs.add_parser('check')
    check.add_argument('--keys', type=Path, required=True, metavar='FILE')
    check.add_argument('archive', type=Path, metavar='ARCHIVE')
    request = verbs.add_parser('request')
    request.add_argument('--release', type=int, required=True, metavar='N')
    request.add_argument('archive', type=Path, nargs='?', default=config.UPDATE, metavar='ARCHIVE')
    request.add_argument('-o', '--output', type=Path, metavar='REQUEST')
    attach = verbs.add_parser('attach')
    attach.add_argument('--request', type=Path, required=True, metavar='REQUEST')
    attach.add_argument('--signature', required=True, metavar='SIG')
    attach.add_argument('--keys', type=Path, required=True, metavar='FILE')
    attach.add_argument('archive', type=Path, nargs='?', default=config.UPDATE, metavar='ARCHIVE')
    attach.add_argument('-o', '--output', type=Path, metavar='OUT')
    args = parser.parse_args()
    try:
        if args.verb == 'keygen':
            seed = seal.new_seed()
            public, _ = seal.signer(seed)
            # Made new and for its owner alone, or not at all: a key is never overwritten.
            try:
                handle = os.open(args.keyfile, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
            except FileExistsError:
                raise StepFailed(f'{args.keyfile} exists; a key is never overwritten') from None
            with os.fdopen(handle, 'w') as stream:
                stream.write(seed.hex() + '\n')
            print(f'sign: the signing key is in {args.keyfile}; keep it private. Its line for a '
                  'release-keys file:', file=sys.stderr)
            print(key_line(public, args.keyfile.stem))
        elif args.verb == 'public':
            public, _ = seal.signer(read_seed(args.keyfile))
            print(key_line(public, args.keyfile.stem))
        elif args.verb == 'archive':
            public, sign = seal.signer(read_seed(args.key))
            output = args.output or args.archive.with_name(f'w1700k-release-{args.release}.tar')
            if output.resolve() != args.archive.resolve():
                unwritten(output, 'a release')
            bundle.sign(args.archive, output, args.release, sign)
            print(f'sign: {output} is release {args.release}, sealed by {seal.fingerprint(public)}')
        elif args.verb == 'request':
            when = int(time.time() * 1000)
            manifest, message = bundle.to_sign(args.archive, args.release, when)
            output = unwritten(args.output or args.archive.with_name(f'w1700k-release-{args.release}.request.json'),
                               'a request that may be out for signing')
            digest = hashlib.sha256(message).hexdigest()
            output.write_text(json.dumps({
                'request': 'a signature for a W1700K SDR release: Ed25519 (RFC 8032) over the bytes in `sign`',
                'product': seal.PRODUCT, 'topic': seal.TOPIC, 'release': args.release, 'time_ms': when,
                'manifest_sha256': hashlib.sha256(manifest).hexdigest(),
                'manifest_at': len(message) - len(manifest), 'bytes': len(message),
                'sign': message.hex(), 'sign_sha256': digest}, indent=1) + '\n')
            print(f'sign: {output} asks for release {args.release} of {args.archive}: {len(message)} bytes to '
                  f'sign, SHA-256 {digest}')
        elif args.verb == 'attach':
            release, when, message = read_request(args.request)
            signature = read_signature(args.signature)
            keys = seal.read_keys(args.keys.read_text())
            key = next((key for key in keys if seal.verifies(key, message, signature)), None)
            if key is None:
                raise StepFailed(f'that signature is not over the bytes of {args.request} by a key in {args.keys} ('
                                 + (', '.join(map(seal.fingerprint, keys)) or 'it holds none') + ')')
            output = unwritten(args.output or args.archive.with_name(f'w1700k-release-{release}.tar'), 'a release')

            def returned(asked):
                if asked != message:
                    raise StepFailed(f'{args.archive} is not the archive {args.request} was made of')
                return signature
            bundle.sign(args.archive, output, release, returned, when, keys)
            print(f'sign: {output} is release {release}, sealed by {seal.fingerprint(key)}')
        else:
            keys = seal.read_keys(args.keys.read_text())
            manifest, _, sealed = bundle.read_release(args.archive)
            if sealed is None:
                raise StepFailed(f'{args.archive} is not sealed: an update archive, not a release')
            release, _, key = seal.unseal(sealed, keys)
            print(f'sign: {args.archive} is release {release}, sealed by {seal.fingerprint(key)}; '
                  f'its {len(manifest["files"])} images are the ones its manifest lists')
    except (StepFailed, seal.Refused) as error:
        sys.exit(f'sign: {error}')
    except OSError as error:
        sys.exit(f'sign: {error}')
    return 0


if __name__ == '__main__':
    sys.exit(main())
