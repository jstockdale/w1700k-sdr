#!/usr/bin/env python3
# SPDX-License-Identifier: MIT
"""At the bench, on a unit's serial console: its list of keys.

    init/bench key FIRST.wms2 [LATER.wms2 ...]     # give a unit that holds no list its first
    init/bench key --carry DIR                     # the same, from every *.wms2 in DIR
    init/bench unkey                               # forget the list, and that there was one
    init/bench show                                # what the unit holds

A keyed unit takes only releases sealed by a release key of the list it holds, and its list
changes only by a list sealed by a root or keys key of it (init/sign, seal/README.md). The first
list has nothing before it, so it is given here, by hand, and the tool stops for you to hold
the fingerprints of its root and keys keys to the record of how they were issued. A unit that
is keyed carries a mark of it in the stock boot loader's environment, outside its durable
storage and outside everything an update replaces: if it ever loses its list it takes nothing
sealed until it is brought back to the bench. `key` sets the mark and `unkey` clears it, at
the stock loader's prompt, so each restarts the unit once.

Nothing here goes over the network, and a unit does none of it over the network.
"""
import argparse
from pathlib import Path
import sys

sys.path.insert(0, str(Path(__file__).resolve().parent))
from initkit import config, keying, seal, session      # noqa: E402
from initkit.console import StepFailed                  # noqa: E402


def main():
    settings = config.load()
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    config.add_arguments(parser, settings)
    verbs = parser.add_subparsers(dest='verb', required=True)
    key = verbs.add_parser('key')
    key.add_argument('--carry', type=Path, metavar='DIR')
    key.add_argument('lists', type=Path, nargs='*', metavar='LIST.wms2')
    verbs.add_parser('unkey')
    verbs.add_parser('show')
    args = parser.parse_args()
    settings = session.settings_from(args)
    try:
        if args.verb == 'key':
            paths = list(args.lists) + (sorted(args.carry.glob('*.wms2')) if args.carry else [])
            try:
                rotations = keying.in_order(path.read_bytes() for path in paths)
            except (OSError, seal.Refused) as error:
                raise StepFailed(f'not a sealed list of keys: {error}') from None
            return keying.key(settings, rotations)
        if args.verb == 'unkey':
            return keying.unkey(settings)
        return keying.show(settings)
    except (StepFailed, RuntimeError) as error:
        sys.exit(f'bench: {error}')
    except KeyboardInterrupt:
        sys.exit('bench: interrupted')


if __name__ == '__main__':
    sys.exit(main())
