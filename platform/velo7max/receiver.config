# What the receiver's kernel on the Velo7 Max asks for beyond OpenWrt's generic and
# mediatek/filogic configurations (platform/velo7max/build.py puts those first; OpenWrt's own
# build system adds settings of this kind itself). The build fails if Kconfig drops one.

# A root in an initramfs, started from RAM.
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_INITRAMFS_SOURCE=""
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y

# The w1700k_sdr module, loaded and unloaded by the host's `w1700k load`.
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y

# What a small userland needs and OpenWrt's kernel configuration leaves to its build system.
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_KALLSYMS=y
CONFIG_BUG=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_MULTIUSER=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_SHMEM=y
CONFIG_AIO=y
CONFIG_POSIX_TIMERS=y
CONFIG_FILE_LOCKING=y
CONFIG_UNIX=y
CONFIG_PACKET=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_PANIC_TIMEOUT=0
CONFIG_MAGIC_SYSRQ=y

# The console and the radio's bus.
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_EARLYCON=y
CONFIG_PCI=y
CONFIG_PCIE_MEDIATEK_GEN3=y
CONFIG_PCIEASPM=y

# The 10 GbE PHYs' patch. Their driver will not finish probing without it: it puts the probe
# off without a word until the file can be had, the ports then open on the generic PHY driver,
# and a PHY given a reset line is left in reset. It has to be there at the first probe, before
# any root, so it is built in, as in the W1700K's kernel and from the same pinned source
# (platform/linux/build.py phy_firmware). The build supplies CONFIG_EXTRA_FIRMWARE_DIR.
CONFIG_FW_LOADER=y
CONFIG_EXTRA_FIRMWARE="rtl8261n.bin"

# Nothing takes a root from the flash.
# CONFIG_MTD_UBI_BLOCK is not set
# CONFIG_MTD_ROOTFS_ROOT_DEV is not set
