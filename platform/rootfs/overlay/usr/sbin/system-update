#!/bin/sh
# SPDX-License-Identifier: MIT
# Updates without a serial console: Linux never writes `system` or a loader, so
# it leaves the new root, or a new loader, in durable storage and the loader
# writes it at the next boot (update_apply and loader_next in the loader's
# environment). init/flash --ssh drives this.
#
#   system-update status                what runs, what is staged, what the loader made of it
#   system-update release ENVELOPE      verify a release's sealed manifest (manifest.wms2 of a
#                                       signed archive) against the release keys this unit holds
#   system-update keys                  the list of keys this unit holds, as it is kept
#   system-update rotate ENVELOPE       take a new list of keys, sealed by a key of the list held
#   system-update first ENVELOPE        at the bench: give a marked unit that holds no list its first
#   system-update unkey                 at the bench: forget the list
#   system-update stage IMAGE SHA256 [--unsigned]
#                                       leave IMAGE (a SquashFS root, e.g. in /work) for the
#                                       loader, with the running root beside it to go back to
#   system-update stage-loader IMAGE SHA256 [--unsigned]
#                                       leave IMAGE (a second loader, w1700k-loader-b.itb) for
#                                       the first loader to put in `loader-b` and start
#   system-update confirm               what was staged runs and is wanted: settle on it
#   system-update cancel                forget what is staged
#
# The loader stock boots, in `loader`, is written over the serial console only.
# A loader that comes this way goes beside it and is started by it; one that is
# never confirmed is removed again by the first loader, at the next boot.
#
# After `stage`, reboot. The loader writes the new root, reads it back and boots
# it; `confirm` then keeps it. A boot that finds it still unconfirmed puts the
# previous root back, so a root that does not come up is undone by a power cycle.
#
# A keyed unit holds a list of keys (seal/release.c says what a list is) in durable storage,
# where no update reaches it, and stages only what a release sealed by a release key of that
# list lists: `release` first, then the images, whose digests must be in its manifest. The
# release's number is kept once the update is confirmed, and nothing older is taken after
# that; a unit has no clock, so the number is all it can hold a release to. One thing passes
# without being in a manifest, and says so:
#   --unsigned       the owner's own build. Whoever can run this as root owns the unit.
# A release's root goes to every unit as it is: nothing of a unit is in its root (its login keys
# and its ssh host key are in durable storage), so the root is checked here like the loader. A
# root the host made for one unit, with network settings of its own in it, is a build of the
# owner's and goes as one.
#
# The list changes in one way: `rotate`, with a list of a higher generation sealed by a root
# or keys key of the list held. No update carries a list, so a key that seals releases cannot
# change who is trusted. A unit gets its first list at the bench, on its serial console
# (`first`), and before it a mark that it is keyed: `w1700k_keyed=1` in the stock boot loader's
# environment, which only the stock loader's prompt writes and which is outside durable storage
# and outside everything an update replaces. Nothing here sets or clears the mark; init/bench
# does, at that prompt. So there are three kinds of unit:
#   unkeyed   no mark and no list: it takes any update, as a unit someone built themselves does
#   keyed     a list that reads: releases and rotations sealed for it, and nothing else
#   lost      the mark, or a list, but no list that reads: nothing but --unsigned, until it is
#             given a list at the bench again. A stock environment that does not read counts
#             as a mark: what cannot be told is not taken for unkeyed.
# Whoever is root on a unit can do all of this by hand; the mark and the console are there so
# that nothing this script is asked over the network does it.
set -eu
. /etc/w1700k/storage.conf
STAGED=/durable/update
MARK='staged-update 1'		# in the description of a loader that applies updates
SECOND_MARK='second-loader 1'	# and of one that starts a second loader from `loader-b`
SECOND_KIND='W1700K SDR second ARM loader'	# the description of such a second loader
RELEASE=/usr/sbin/w1700k-release	# the verifier
STATE=/run/w1700k-release	# the release it verified this boot (in RAM)
FLOOR=/durable/release		# the number of the newest release this unit settled on
KEYS=/durable/keys		# the list of keys this unit trusts
HELD=/run/w1700k-keys.$$	# this run's copy of it (in RAM)
LOCK=/run/w1700k-update.lock	# one run at a time changes anything
MARKED=uenv			# the partition of the stock environment, where the mark of a keyed unit is
CONSOLE=/dev/console		# where the bench is

fail() { echo "system-update: $*" >&2; exit 1; }

# Whatever this run leaves in RAM goes with it, and so does its hold on the unit.
trap 'rm -f "$HELD" "$HELD.new" "$HELD.new.part"; [ -z "${LOCKED:-}" ] || rm -rf "$LOCK"' EXIT
trap 'exit 130' INT TERM HUP

alone()		# nothing else changes this unit's update state or its keys while this run does
{
	if ! mkdir "$LOCK" 2>/dev/null; then
		# A run that was killed left its hold behind; one that still runs keeps it.
		other=$(cat "$LOCK/pid" 2>/dev/null || :)
		case $other in ''|*[!0-9]*) other= ;; esac
		[ -z "$other" ] || ! kill -0 "$other" 2>/dev/null ||
			fail "another system-update is at work on this unit (process $other); try again when it is done"
		rm -rf "$LOCK"
		mkdir "$LOCK" 2>/dev/null || fail "another system-update is at work on this unit; try again when it is done"
	fi
	LOCKED=1
	echo "$$" > "$LOCK/pid"
}

volume()	# the UBI volume named $1 on ubi0, as /dev/ubi0_N
{
	for v in /sys/class/ubi/ubi0_*; do
		[ "$(cat "$v/name")" = "$1" ] && { echo "/dev/${v##*/}"; return; }
	done
	fail "no $1 volume"
}

partition()	# the read-only node of the MTD partition named $1
{
	for m in /sys/class/mtd/mtd[0-9]*; do
		case $m in *ro) continue ;; esac
		[ "$(cat "$m/name")" = "$1" ] && { echo "/dev/${m##*/}ro"; return; }
	done
	fail "no $1 partition"
}

digest() { sha256sum | cut -d' ' -f1; }
running() { digest < "$(volume rootfs)"; }
installed() { grep -Eq '^/dev/ubiblock0_[0-9]+ /\.lower squashfs ' /proc/mounts; }
loader_applies() { grep -q "$MARK" "$(partition loader)"; }
loader_starts_second() { grep -q "$SECOND_MARK" "$(partition loader)"; }

second_loader()	# the digest of the image in `loader-b`; nothing when it holds no image
{
	node=$(partition loader-b)
	[ "$(dd if="$node" bs=4 count=1 2>/dev/null | hexdump -v -e '4/1 "%02x"')" = d00dfeed ] || return 0
	size=$((0x$(dd if="$node" bs=4 skip=1 count=1 2>/dev/null | hexdump -v -e '4/1 "%02x"')))
	[ "$size" -le "$(cat "/sys/class/mtd/$(basename "${node%ro}")/size")" ] || return 0
	head -c "$size" "$node" | digest
}

# What the loader keeps while an update is neither confirmed nor undone: digests, and
# nothing else is passed on as one.
loader_note() { fw_printenv -n "$1" 2>/dev/null | head -n 1 | tr -cd '0-9a-f' || :; }

staged()	# the staged request's two digests, new then old; nothing when none is staged
{
	/usr/sbin/durable-run sh -c '
		[ ! -f "$1/request" ] || echo "request: $(sed -n "s/^update_new=//p; s/^update_old=//p" "$1/request" | tr "\n" " ")"
	' sh "$STAGED" | sed -n 's/^request: //p'
}

staged_loader()	# the staged second loader's digest; nothing when none is staged
{
	/usr/sbin/durable-run sh -c '
		[ ! -f "$1/request" ] || echo "request: $(sed -n "s/^loader_new=//p" "$1/request")"
	' sh "$STAGED" | sed -n 's/^request: //p'
}

mark()	# yes, no, or unreadable: is this unit marked as keyed?
{
	code=0
	"$RELEASE" mark --environment "$(partition "$MARKED")" > /dev/null 2>&1 || code=$?
	case $code in 0) echo yes ;; 1) echo no ;; *) echo unreadable ;; esac
}

look()	# LIST: is the list held good, none or damaged? MARK. REGIME: unkeyed, keyed or lost
{
	# A root from before there were lists has no verifier, or one that knows nothing of
	# lists and marks. A unit on such a root was never keyed, unless it carries a list or
	# the mark all the same: then it is a keyed unit on a root that can judge nothing, and
	# takes nothing sealed.
	if [ ! -x "$RELEASE" ] || ! "$RELEASE" mark --environment /dev/null 2>&1 | grep -q 'stock environment'; then
		LIST=none MARK=no
		/usr/sbin/durable-run sh -c '[ ! -e "$1" ]' sh "$KEYS" > /dev/null 2>&1 || LIST=damaged
		! head -c 16384 "$(partition "$MARKED")" 2>/dev/null | tr '\0' '\n' | grep -qx 'w1700k_keyed=1' ||
			MARK=yes
		[ "$LIST$MARK" = noneno ] && REGIME=unkeyed || REGIME=lost
		return 0
	fi
	MARK=$(mark)
	rm -f "$HELD" "$HELD.new"
	/usr/sbin/durable-run sh -c '[ ! -e "$1" ] || cat "$1" > "$2"' sh "$KEYS" "$HELD" > /dev/null ||
		fail "durable storage could not be read for the key list"
	if [ ! -e "$HELD" ]; then
		LIST=none
	elif "$RELEASE" list --keys "$HELD" > /dev/null 2>&1; then
		LIST=good
	else
		LIST=damaged
	fi
	case $LIST in
	good) REGIME=keyed ;;
	none) [ "$MARK" = no ] && REGIME=unkeyed || REGIME=lost ;;
	*) REGIME=lost ;;
	esac
}

generation() { "$RELEASE" list --keys "$HELD" 2>/dev/null | sed -n 's/^generation=//p'; }

lost() { fail "this unit was given a list of keys and holds none that reads (list $LIST, mark $MARK): it takes no" \
	"sealed update until it is given a list at the bench again (system-update first)${1:-}"; }

at_the_bench()	# $1 names what is being done
{
	[ "$(tty 2>/dev/null || :)" = "$CONSOLE" ] ||
		fail "$1 is done at the bench, on the unit's serial console, and nowhere else"
}

keep_list()	# put $HELD.new, which the verifier wrote, in the list's place
{
	/usr/sbin/durable-run sh -eu -c '
		cp "$2" "$1.part"
		sync
		mv "$1.part" "$1"
		sync
		[ "$(sha256sum < "$1" | cut -d" " -f1)" = "$(sha256sum < "$2" | cut -d" " -f1)" ]
	' sh "$KEYS" "$HELD.new" > /dev/null
}

settled()	# what is kept of the newest release settled on: its number, then its manifest's digest;
		# `none' before the first, and nothing at all when durable storage does not say
{
	/usr/sbin/durable-run sh -c 'if [ -e "$1" ]; then echo "floor: $(cat "$1")"; else echo "floor: none"; fi' \
		sh "$FLOOR" | sed -n 's/^floor: //p'
}

release_floor()	# the newest release settled on; 0 before the first; `unreadable' for what is no number
{
	set -- $(settled)
	case ${1:-} in none) echo 0 ;; ''|*[!0-9]*) echo unreadable ;; *) echo "$1" ;; esac
}

floor()		# the same for a decision: a number that does not read stops it
{
	number=$(release_floor)
	[ "$number" != unreadable ] || fail "the number of the release this unit settled on does not read" \
		"($FLOOR): it takes no release until it is keyed at the bench again"
	echo "$number"
}

verified() { "$RELEASE" number --state "$STATE" 2>/dev/null || :; }

permitted()	# may the image with digest $1 be staged, given the flag $2? $3 names it
{
	look
	[ "$REGIME" != unkeyed ] || return 0
	if [ "${2:-}" = --unsigned ]; then
		echo "system-update: taking $3 unsigned, on the owner's word" >&2
		return 0
	fi
	[ "$REGIME" = keyed ] || lost ", or pass --unsigned for a build of your own"
	"$RELEASE" allows --state "$STATE" "$1"
}

note_release()	# beside what is staged: the release it comes from, for `confirm` to keep
{
	number=$(verified)
	[ -n "$number" ] || return 0
	/usr/sbin/durable-run sh -c 'echo "$2 $3" > "$1/release" && sync' sh "$STAGED" "$number" \
		"$(digest < "$STATE/manifest")" > /dev/null || fail "the release's number could not be noted"
}

unnote_release()	# what is staged on the owner's word comes from no release, and moves no floor
{
	/usr/sbin/durable-run sh -c 'rm -f "$1/release" && sync' sh "$STAGED" > /dev/null ||
		fail "an earlier release's number could not be forgotten"
}

forget()
{
	/usr/sbin/durable-run rm -rf "$STAGED" > /dev/null || fail "the staged files are still there"
}

case ${1:-} in
status)
	echo "running=$(running)"
	installed && echo "boot=installed" || echo "boot=ram"
	loader_applies && echo "loader=applies" || echo "loader=serial-only"
	set -- $(staged)
	echo "staged=${1:-}"
	echo "previous=${2:-}"
	echo "tried=$(loader_note update_tried)"
	echo "failed=$(loader_note update_failed)"
	loader_starts_second && echo "second_loader=$(second_loader)" || echo "second_loader=unsupported"
	echo "loader_staged=$(staged_loader)"
	echo "loader_tried=$(loader_note loader_tried)"
	echo "loader_booted=$(loader_note loader_booted)"
	echo "loader_failed=$(loader_note loader_failed)"
	look
	echo "keys=$REGIME"
	echo "key_mark=$MARK"
	echo "key_list=$LIST"
	echo "key_generation=$(generation)"
	echo "release_keys=$("$RELEASE" list --keys "$HELD" 2>/dev/null | grep -c '^release ' || :)"
	echo "release=$(release_floor)"
	set -- $(settled)
	echo "release_manifest=${2:-}"
	echo "release_verified=$(verified)"
	;;
release)
	envelope=${2:-}
	[ -f "$envelope" ] || fail "usage: system-update release ENVELOPE"
	alone
	# What was verified before stands for nothing once another release is asked about.
	rm -rf "$STATE"
	look
	[ "$REGIME" != unkeyed ] || fail "this unit holds no list of keys; it takes any update"
	[ "$REGIME" = keyed ] || lost
	number=$(floor) || exit 1
	"$RELEASE" verify --keys "$HELD" --state "$STATE" --floor "$number" "$envelope" > /dev/null ||
		fail "not a release this unit takes"
	# The number this unit settled on is one release: another under the same number is not it.
	set -- $(settled)
	if [ "$(verified)" = "${1:-}" ] && [ -n "${2:-}" ] && [ "$(digest < "$STATE/manifest")" != "$2" ]; then
		rm -rf "$STATE"
		fail "this is ANOTHER release $1 than the one this unit settled on: two were sealed under one number"
	fi
	echo "system-update: release $(verified) verified; its images can be staged"
	;;
keys)
	look
	[ "$LIST" = good ] || fail "this unit holds no list of keys that reads ($LIST)"
	cat "$HELD"
	;;
rotate)
	envelope=${2:-}
	[ -f "$envelope" ] || fail "usage: system-update rotate ENVELOPE"
	alone
	look
	[ "$REGIME" != unkeyed ] || fail "this unit holds no list of keys: its first is given at the bench" \
		"(system-update first)"
	[ "$REGIME" = keyed ] || lost
	said=$("$RELEASE" rotate --keys "$HELD" --out "$HELD.new" "$envelope") || fail "not a list this unit takes"
	case $said in
	*unchanged) echo "system-update: this is the list held ($said)"; exit 0 ;;
	esac
	keep_list || fail "the new list could not be kept; look at what is held (system-update keys)"
	# A release verified under the list that was held is not one verified under this.
	rm -rf "$STATE"
	echo "system-update: the list of keys is now $said"
	;;
first)
	envelope=${2:-}
	[ -f "$envelope" ] || fail "usage: system-update first ENVELOPE"
	at_the_bench "giving a unit its first list of keys"
	alone
	rm -rf "$STATE"
	look
	[ "$LIST" != good ] || fail "this unit holds a list of keys ($(generation)): a new one" \
		"reaches it as a rotation, or unkey it first (init/bench unkey)"
	# The mark comes before the list, and from the stock boot loader's prompt: a unit that
	# stops between the two takes nothing, which is the side to fall on.
	[ "$MARK" = yes ] || fail "this unit is not marked as keyed (mark $MARK): the mark is set at the stock" \
		"boot loader's prompt before the list is given (init/bench key does both)"
	said=$("$RELEASE" rotate --first --out "$HELD.new" "$envelope") || fail "not a first list"
	keep_list || fail "the unit is marked keyed and the list could not be kept: it takes nothing until" \
		"this is done again"
	# Release numbers start again with the keys that seal them.
	/usr/sbin/durable-run sh -c 'rm -f "$1" && sync' sh "$FLOOR" > /dev/null ||
		fail "the list is kept, but the old release number could not be forgotten"
	echo "system-update: this unit is keyed; its list is $said"
	"$RELEASE" list --keys "$HELD.new"
	;;
unkey)
	at_the_bench "unkeying a unit"
	alone
	rm -rf "$STATE"
	/usr/sbin/durable-run sh -c 'rm -f "$1" "$1.part" "$2" && sync' sh "$KEYS" "$FLOOR" > /dev/null ||
		fail "the list could not be removed; nothing is changed"
	look
	echo "system-update: this unit holds no list of keys (mark $MARK). While it is marked it takes nothing" \
		"sealed: the mark is cleared at the stock boot loader's prompt (init/bench unkey does both)"
	;;
stage)
	image=${2:-} want=${3:-}
	[ -f "$image" ] && [ -n "$want" ] || fail "usage: system-update stage IMAGE SHA256 [--unsigned]"
	alone
	installed || fail "this boot runs from RAM, not from the installed root"
	loader_applies || fail "the loader on this unit does not apply staged updates: " \
		"flash it once over the serial console (init/flash --loader)"
	[ "$(digest < "$image")" = "$want" ] || fail "$image is not $want"
	permitted "$want" "${4:-}" "this root" || fail "this unit takes releases: verify one first " \
		"(system-update release), whose manifest lists this root; " \
		"or pass --unsigned for a build of your own"
	root=$(volume rootfs)
	sys=/sys/class/ubi/${root##*/}
	room=$(($(cat "$sys/reserved_ebs") * $(cat "$sys/usable_eb_size")))
	size=$(wc -c < "$image")
	[ "$size" -le "$room" ] || fail "$image ($size bytes) does not fit the root volume ($room)"
	old=$(running)
	[ "$old" != "$want" ] || { echo "system-update: this root already runs"; exit 0; }
	/usr/sbin/durable-run sh -eu -c '
		staged=$1 image=$2 want=$3 root=$4 old=$5 size=$6
		mkdir -p "$staged"
		# A loader staged beside it stays; the request goes first, so nothing half is acted on.
		keep=$(sed -n "/^loader_new=/p" "$staged/request" 2>/dev/null || :)
		rm -f "$staged/request" "$staged/request.part" "$staged/rootfs.new" "$staged/rootfs.old"
		sync
		free=$(($(df -k /durable | sed -n 2p | tr -s " " | cut -d" " -f4) * 1024))
		[ "$free" -gt $((2 * size + 1048576)) ] || { echo "durable storage has $free bytes free" >&2; exit 1; }
		cp "$image" "$staged/rootfs.new"
		cat "$root" > "$staged/rootfs.old"
		sync
		[ "$(sha256sum < "$staged/rootfs.new" | cut -d" " -f1)" = "$want" ]
		[ "$(sha256sum < "$staged/rootfs.old" | cut -d" " -f1)" = "$old" ]
		# The request last and whole: the loader acts on it alone.
		{ printf "update_new=%s\nupdate_old=%s\n" "$want" "$old"; [ -z "$keep" ] || echo "$keep"; } > "$staged/request.part"
		sync
		mv "$staged/request.part" "$staged/request"
		sync
	' sh "$STAGED" "$image" "$want" "$root" "$old" "$size" || fail "nothing is staged"
	if [ "${4:-}" = --unsigned ]; then unnote_release; else note_release; fi
	echo "system-update: staged $want over $old; reboot to have the loader write it"
	;;
stage-loader)
	image=${2:-} want=${3:-}
	[ -f "$image" ] && [ -n "$want" ] || fail "usage: system-update stage-loader IMAGE SHA256 [--unsigned]"
	alone
	installed || fail "this boot runs from RAM, not from the installed root"
	loader_starts_second || fail "the loader on this unit starts no second loader: " \
		"flash it once over the serial console (init/flash --loader)"
	[ "$(digest < "$image")" = "$want" ] || fail "$image is not $want"
	head -c 512 "$image" | grep -q "$SECOND_KIND" ||
		fail "$image is not a second loader (w1700k-loader-b.itb)"
	case ${4:-} in ''|--unsigned) ;; *) fail "usage: system-update stage-loader IMAGE SHA256 [--unsigned]" ;; esac
	permitted "$want" "${4:-}" "this loader" || fail "this unit takes releases: verify one first " \
		"(system-update release) whose manifest lists this loader, or pass --unsigned for a " \
		"build of your own"
	node=$(partition loader-b)
	room=$(cat "/sys/class/mtd/$(basename "${node%ro}")/size")
	size=$(wc -c < "$image")
	[ "$size" -le "$room" ] || fail "$image ($size bytes) does not fit loader-b ($room)"
	[ "$(second_loader)" != "$want" ] || { echo "system-update: this loader is already in place"; exit 0; }
	/usr/sbin/durable-run sh -eu -c '
		staged=$1 image=$2 want=$3 size=$4
		mkdir -p "$staged"
		keep=$(sed -n "/^update_/p" "$staged/request" 2>/dev/null || :)
		rm -f "$staged/request" "$staged/request.part" "$staged/loader.new"
		sync
		free=$(($(df -k /durable | sed -n 2p | tr -s " " | cut -d" " -f4) * 1024))
		[ "$free" -gt $((size + 1048576)) ] || { echo "durable storage has $free bytes free" >&2; exit 1; }
		cp "$image" "$staged/loader.new"
		sync
		[ "$(sha256sum < "$staged/loader.new" | cut -d" " -f1)" = "$want" ]
		{ [ -z "$keep" ] || echo "$keep"; printf "loader_new=%s\n" "$want"; } > "$staged/request.part"
		sync
		mv "$staged/request.part" "$staged/request"
		sync
	' sh "$STAGED" "$image" "$want" "$size" || fail "no loader is staged"
	if [ "${4:-}" = --unsigned ]; then unnote_release; else note_release; fi
	echo "system-update: staged the loader $want; reboot to have the first loader write and start it"
	;;
confirm)
	alone
	now=$(running)
	set -- $(staged)
	loader=$(staged_loader)
	[ -n "${1:-}" ] || [ -n "$loader" ] || fail "nothing is staged"
	[ -z "${1:-}" ] || [ "$now" = "$1" ] || fail "the staged root is $1, and $now runs"
	if [ -n "$loader" ]; then
		[ "$(loader_note loader_booted)" = "$loader" ] ||
			fail "the staged loader $loader did not start this boot"
		[ "$(second_loader)" = "$loader" ] || fail "loader-b does not hold the staged loader $loader"
	fi
	# What was staged from a release moves the floor up to it: nothing older is taken again.
	noted=$(/usr/sbin/durable-run sh -c '[ ! -f "$1/release" ] || echo "release: $(cat "$1/release")"' \
		sh "$STAGED" | sed -n 's/^release: //p')
	number=${noted%% *}
	case $number in *[!0-9]*) number= ;; esac
	if [ -n "$number" ]; then
		kept=$(floor) || exit 1
		[ "$number" -gt "$kept" ] || number=
	fi
	# The number first, then what was staged: a unit that stops between the two has moved
	# its floor and still has its update to settle, not the other way round.
	[ -z "$number" ] || /usr/sbin/durable-run sh -c \
		'echo "$2" > "$1.part" && sync && mv "$1.part" "$1" && sync' sh "$FLOOR" "$noted" > /dev/null ||
		fail "the release's number could not be kept; nothing is settled"
	forget
	echo "system-update: settled on root $now${loader:+ and loader $loader}${number:+, release $number}"
	;;
cancel)
	alone
	forget
	echo "system-update: nothing is staged"
	;;
*)
	echo "usage: system-update status | release ENVELOPE | stage IMAGE SHA256 [--unsigned] |" >&2
	echo "       stage-loader IMAGE SHA256 [--unsigned] | confirm | cancel |" >&2
	echo "       keys | rotate ENVELOPE | first ENVELOPE | unkey" >&2
	exit 2
	;;
esac
